# versions.env -- the single source of truth for everything this repo pins.
# Sourced by scripts/build_toolchain.sh and by the GitHub workflow.
# Changing a version that is downloaded means deleting checksums.sha256 and
# re-running `fetch --record` on purpose (see README).

# ── What we build FOR: bare-metal 68000, no operating system ────────────────
TARGET="m68k-elf"
TARGET_CPU="m68000"

# ── Compiler ────────────────────────────────────────────────────────────────
# Matches the GCC that SGDK 2.11 ships for Windows, so all three OSes agree.
GCC_VERSION="13.2.0"
BINUTILS_VERSION="2.41"   # release contemporary with GCC 13.2

GCC_FILE="gcc-${GCC_VERSION}.tar.xz"
GCC_URL="https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/${GCC_FILE}"

BINUTILS_FILE="binutils-${BINUTILS_VERSION}.tar.xz"
BINUTILS_URL="https://ftp.gnu.org/gnu/binutils/${BINUTILS_FILE}"

# Our own fixes applied to the GCC source after unpacking (files in patches/).
GCC_PATCHES=(
    "gcc-13.2.0-safe-ctype-order.patch"   # builds with libc++ (macOS); from GCC 13.3
)

# ── SGDK ────────────────────────────────────────────────────────────────────
SGDK_TAG="v2.11"
SGDK_FILE="sgdk-${SGDK_TAG}.tar.gz"
SGDK_URL="https://github.com/Stephane-D/SGDK/archive/refs/tags/${SGDK_TAG}.tar.gz"
SGDK_TOP_DIR="SGDK-${SGDK_TAG#v}"   # folder the SGDK archive unpacks to

# ── Java for SGDK's tools: Temurin (Eclipse Adoptium), Java 21 LTS ──────────
# One archive per OS; each bundle includes the one for its OS.
JRE_VERSION="21.0.12.1+1"
JRE_URL_BASE="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1"
JRE_TOP_DIR="jdk-21.0.12.1+1-jre"   # folder each archive unpacks to
JRE_FILE_LINUX_X64="OpenJDK21U-jre_x64_linux_hotspot_21.0.12.1_1.tar.gz"
JRE_FILE_MACOS_ARM64="OpenJDK21U-jre_aarch64_mac_hotspot_21.0.12.1_1.tar.gz"
JRE_FILE_WINDOWS_X64="OpenJDK21U-jre_x64_windows_hotspot_21.0.12.1_1.zip"
# Java's source code, attached to each release (GPL). Not used by the build,
# so it is not in ARTIFACTS; the workflow checks it against Adoptium's sum.
JRE_SOURCES_FILE="OpenJDK21U-jdk-sources_21.0.12.1_1.tar.gz"

# ── Bundle identity ─────────────────────────────────────────────────────────
# Bump TOOLCHAIN_REVISION when the recipe changes but the pinned versions
# don't, so the new bundle (and its GitHub release) gets a new ID.
TOOLCHAIN_REVISION="1"
TOOLCHAIN_ID="sgdk${SGDK_TAG#v}-gcc${GCC_VERSION}-r${TOOLCHAIN_REVISION}"
# Format version of toolchain.json. The editor checks it before reading
# the rest; bump it only when the file's layout changes.
TOOLCHAIN_MANIFEST_SCHEMA="1"

# ── Everything `fetch` downloads, as "filename|url" ─────────────────────────
ARTIFACTS=(
    "${BINUTILS_FILE}|${BINUTILS_URL}"
    "${GCC_FILE}|${GCC_URL}"
    "${SGDK_FILE}|${SGDK_URL}"
    "${JRE_FILE_LINUX_X64}|${JRE_URL_BASE}/${JRE_FILE_LINUX_X64}"
    "${JRE_FILE_MACOS_ARM64}|${JRE_URL_BASE}/${JRE_FILE_MACOS_ARM64}"
    "${JRE_FILE_WINDOWS_X64}|${JRE_URL_BASE}/${JRE_FILE_WINDOWS_X64}"
)
